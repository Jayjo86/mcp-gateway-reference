# Copy to .env and fill in. No mock IdP — a real Microsoft Entra ID tenant is required.
# A free Microsoft 365 developer tenant works. See README "Entra setup".

# ── Microsoft Entra ID ──────────────────────────────────────────────────────
# Directory (tenant) ID of your Entra tenant. The OIDC discovery URL is derived
# from this in app/config.py rather than configured separately — Compose's
# env_file: doesn't expand ${...} the way python-dotenv does, so a
# ENTRA_OIDC_CONFIG=.../${ENTRA_TENANT_ID}/... entry here could reach the
# gateway unexpanded.
ENTRA_TENANT_ID=

# App registration: the gateway (confidential client).
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET=
# Application ID URI exposed by the gateway app reg ("Expose an API" in Entra portal).
# The gateway acts as an OAuth AS (AzureProvider): MCP clients do the full PKCE
# flow against the gateway, which proxies to Entra and issues short-lived FastMCP JWTs.
GATEWAY_AUDIENCE=api://mcp-gateway
# Scope name defined under "Expose an API" in the gateway app reg (unprefixed).
# Full scope URI = GATEWAY_AUDIENCE/GATEWAY_INBOUND_SCOPE = api://mcp-gateway/access_as_user
GATEWAY_INBOUND_SCOPE=access_as_user

# App registrations: one per backend MCP server. Each exposes an Application ID
# URI — either the short form below or the guid-qualified form Entra recommends
# against URI squatting (api://<tenant-or-app-guid>/mcp-server-a). This is the
# only place that format is configured: the tool registry holds scope suffixes
# ("Ledger.Write") and combines them with this audience at request time.
MCP_SERVER_A_AUDIENCE=api://mcp-server-a
MCP_SERVER_B_AUDIENCE=api://mcp-server-b
# Application (client) ID GUID of each backend's app registration, from the app
# reg's Overview page — not derived from the audience above. Entra puts this bare
# GUID in `aud` instead of the api:// URI for tokens minted against a `.default`
# scope (M2M, and the gateway's list-prefetch OBO fallback), so each backend's
# JWTVerifier accepts both forms. Required even without M2M: the list prefetch
# takes this path for every backend.
MCP_SERVER_A_APP_ID=
MCP_SERVER_B_APP_ID=
# Backend default scope (typically <audience>/.default). Used by M2M — which
# needs an app-role assignment for the gateway on each backend API — and as the
# OBO fallback for calls with no per-tool scope.
#
# OBO tool calls request a least-privilege per-tool scope instead, built from the
# audience above plus the suffix in app/tools/registry.py. Those granular scopes
# must be exposed on each backend API's app reg and delegated-permission-granted
# to the gateway app.
MCP_SERVER_A_SCOPE=api://mcp-server-a/.default
MCP_SERVER_B_SCOPE=api://mcp-server-b/.default

# ── Gateway ─────────────────────────────────────────────────────────────────
# Public base URL advertised in OAuth metadata and used as the issuer for
# FastMCP-issued JWTs. MCP clients must be able to reach this URL.
# Register {GATEWAY_PUBLIC_URL}/auth/callback as a redirect URI in the Entra app reg.
# Docker maps host:8443 → container:8000 (see docker-compose.yml ports: "8443:8000").
# Default is plain HTTP — the pragmatic choice for local dev. For TLS, run
# ./scripts/gen-local-certs.sh, fill in GATEWAY_TLS_CERT/KEY below, and switch
# this to https://localhost:8443 — see docs/CLAUDE_CODE_AUTH.md
# ("HTTP vs HTTPS mismatch") for the toggle and the required re-login steps.
GATEWAY_PUBLIC_URL=http://localhost:8443
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
# TLS for local https (generate with scripts/gen-local-certs.sh). Leave blank to run http.
GATEWAY_TLS_CERT=
GATEWAY_TLS_KEY=
# Signing key for FastMCP-issued session JWTs (change in production).
GATEWAY_SESSION_SIGNING_KEY=change-me-dev-only
# Deployment environment. Set to "prod" to force the authorization-consent
# screen on (confused-deputy protection for DCR/CIMD clients).
GATEWAY_ENV=dev
# Require the consent screen for dynamically-registered / CIMD clients. Safe to
# leave false for local dev; MUST be true in production (forced true when
# GATEWAY_ENV=prod regardless of this value).
GATEWAY_REQUIRE_CONSENT=false

# Where the gateway reaches each backend MCP server (in-cluster).
MCP_SERVER_A_URL=http://mcp-server-a:9000/mcp
MCP_SERVER_B_URL=http://mcp-server-b:9000/mcp

# Default downstream token regime for the gateway→backend hop, used for any
# backend that doesn't set its own:
#   m2m — client_credentials, the gateway's own service principal. Needs an
#         app-role assignment on each backend API.
#   obo — Entra On-Behalf-Of, per-user delegation. The user's token is
#         exchanged (as an RFC 7523 jwt-bearer assertion), never forwarded.
DOWNSTREAM_PROFILE=obo
# Per-backend override; blank inherits DOWNSTREAM_PROFILE. This is how you run a
# different regime per server — e.g. M2M to the CRM but OBO to the ledger:
# MCP_SERVER_A_PROFILE=m2m
# MCP_SERVER_B_PROFILE=obo
MCP_SERVER_A_PROFILE=
MCP_SERVER_B_PROFILE=

# ── Dev / observability ─────────────────────────────────────────────────────
# Set to true to enable per-request HTTP traffic logging and DEBUG-level token
# exchange logs (inbound auth headers, Entra token request params, JWT claims).
# Never enable in production — logs contain partial token material.
LOG_TRAFFIC=false

# ── OPA ─────────────────────────────────────────────────────────────────────
OPA_URL=http://opa:8181
# Decision path queried by the gateway.
OPA_DECISION_PATH=v1/data/mcp

# ── Postgres (audit log) ────────────────────────────────────────────────────
POSTGRES_DB=mcp_audit
POSTGRES_USER=mcp
POSTGRES_PASSWORD=mcp-dev-only
AUDIT_DATABASE_URL=postgresql://mcp:mcp-dev-only@postgres:5432/mcp_audit
